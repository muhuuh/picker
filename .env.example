# SEC requires a declared User-Agent for EDGAR API requests.
# Use a real contact email or domain you control.
SEC_USER_AGENT="Stock Research your.email@example.com"

# Provider keys should be added locally in .env, never committed.
EXA_API_KEY="your_exa_api_key_here"
