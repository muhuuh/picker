# SEC requires a declared User-Agent for EDGAR API requests.
# Use a real contact email or domain you control.
SEC_USER_AGENT="Stock Research your.email@example.com"

# Provider keys should be added locally in .env, never committed.
EXA_API_KEY="your_exa_api_key_here"
# xAI/Grok API key for Grok x_search and model calls.
XAI_API_KEY="your_xai_api_key_here"
# Market-data cross-check providers.
FMP_API_KEY="your_fmp_api_key_here"
FMP_API_KEY2="optional_secondary_fmp_api_key_here"
POLYGON_API_KEY="your_polygon_or_massive_api_key_here"
ALPHA_VANTAGE_API_KEY="your_alpha_vantage_api_key_here"
ALPHA_VANTAGE_API_KEY2="optional_secondary_alpha_vantage_api_key_here"

# Optional: only needed for live bounded memory-writer review.
OPENAI_API_KEY="your_openai_api_key_here"
